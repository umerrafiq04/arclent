# Which LLM provider backend/agent/llm.py uses: "groq" (default), "deepseek", or "mistral".
LLM_PROVIDER=groq

# Groq API key + model (used when LLM_PROVIDER=groq) — never exposed to the frontend, read only
# by backend/config.py.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# DeepSeek API key + model — only read when LLM_PROVIDER=deepseek, kept as a rollback path.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Mistral API key + model — only read when LLM_PROVIDER=mistral, kept as a rollback path.
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# SQLite database paths
APP_DB_PATH=database/recruitment.db
CHECKPOINT_DB_PATH=database/checkpoints.sqlite

# FastAPI CORS origin for the static frontend during local dev
FRONTEND_ORIGIN=http://localhost:8000

# Session cookie Secure flag — defaults to on automatically when FRONTEND_ORIGIN is https.
# Leave unset for local http:// dev; set to true in a real HTTPS deployment.
# COOKIE_SECURE=true
